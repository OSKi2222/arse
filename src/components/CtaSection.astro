---
import { SITE } from "../lib/site";
import { localizePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = useTranslations(lang);
---

<section class:list={["bg-white px-5 sm:px-8", compact ? "pb-24 md:pb-32" : "pb-32 md:pb-44"]}>
  <div
    data-reveal
    class="noise-overlay relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-arse-red via-arse-red-dark to-arse-ink px-8 py-20 text-center text-white sm:py-28"
  >
    <h2 data-reveal-item class="relative z-10 mx-auto max-w-3xl text-[clamp(2rem,4vw,3.25rem)] font-bold leading-[1.08]">
      {t.cta.heading}
    </h2>
    <p data-reveal-item class="relative z-10 mx-auto mt-5 max-w-xl text-white/80">{t.cta.text}</p>
    <div data-reveal-item class="relative z-10 mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={localizePath("/contact/", lang)} data-magnetic class="rounded-full bg-white px-8 py-4 text-sm font-semibold text-arse-red">
        {t.cta.primary}
      </a>
      <a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="rounded-full border border-white/30 px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-white/10">
        {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
