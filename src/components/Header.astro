---
import { SITE, NAV_IMAGES } from "../lib/site";
import { getLangFromUrl, useTranslations, localizePath, languages, switchLangPath, type Lang } from "../i18n";
import { withBase } from "../lib/base";
import LangFlag from "./LangFlag.astro";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = t.nav.items;
const langCodes = Object.keys(languages) as Lang[];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="border-b border-black/5 bg-arse-paper/80 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 sm:px-8">
      <a href={localizePath("/", lang)} class="flex items-center gap-3" aria-label={`${t.site.fullName} — ${t.nav.home}`}>
        <img src={withBase("/images/logo-arse.png")} alt={t.site.fullName} class="h-10 w-auto sm:h-12" width="220" height="90" />
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <!--
          Liste déroulante native (<details>) : pas de JS nécessaire, se
          ferme automatiquement au clic sur une option. `data-no-swup`
          force un rechargement complet de la page au changement de
          langue — nécessaire car le Header vit hors du conteneur #swup
          et ne serait donc jamais reconstruit dans la nouvelle langue
          par une navigation SPA.
        -->
        <details class="group relative" aria-label={t.nav.languageLabel}>
          <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-black/10 px-3.5 py-1.5 text-xs font-semibold text-arse-ink [&::-webkit-details-marker]:hidden">
            <LangFlag lang={lang} />
            {languages[lang].short}
            <svg width="10" height="7" viewBox="0 0 10 7" fill="none" class="transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="M1 1.5 5 5.5 9 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="absolute end-0 top-full z-10 mt-2 max-h-[70vh] w-48 overflow-y-auto rounded-xl border border-black/10 bg-white py-1 shadow-lg shadow-black/5">
            {langCodes.map((code) => (
              <a
                href={switchLangPath(Astro.url, code)}
                hreflang={languages[code].htmlLang}
                aria-current={code === lang ? "true" : undefined}
                data-no-swup
                class:list={[
                  "flex items-center justify-between gap-2 px-3.5 py-2 text-sm transition-colors",
                  code === lang ? "font-semibold text-arse-ink" : "text-arse-ink/60 hover:bg-black/5 hover:text-arse-ink",
                ]}
              >
                <span class="flex items-center gap-2">
                  <LangFlag lang={code} />
                  {languages[code].label}
                </span>
                {code === lang && (
                  <svg width="13" height="10" viewBox="0 0 13 10" fill="none" class="shrink-0" aria-hidden="true">
                    <path d="M1 5 4.5 8.5 12 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </details>

        <a
          href={localizePath("/contact/", lang)}
          class="hidden rounded-full bg-arse-green px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-arse-green/30 transition-transform hover:scale-[1.03] sm:inline-flex"
        >
          {t.nav.contact}
        </a>

        <button
          type="button"
          id="menu-toggle"
          class="inline-flex items-center gap-2.5 rounded-full bg-arse-ink px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:scale-[1.03]"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="menu-overlay"
          aria-label={t.nav.openMenu}
        >
          <span>{t.nav.menu}</span>
          <svg width="16" height="11" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M0 1h18M0 11h18" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ===== Menu plein écran (reveal clip-path) ===== -->
  <div id="menu-overlay" class="fixed inset-0 z-[100] hidden bg-arse-ink text-white" style="clip-path: inset(0 0 100% 0);">
    <div class="flex h-full flex-col">
      <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-3 sm:px-8">
        <a href={localizePath("/", lang)} class="flex items-center gap-3">
          <img src={withBase("/images/logo-arse-carre.png")} alt={t.site.fullName} class="h-10 w-10 rounded-lg bg-white/5 p-1" />
          <span class="hidden text-sm font-semibold uppercase tracking-wide text-white/70 sm:block">{t.site.fullName}</span>
        </a>
        <button
          type="button"
          id="menu-close"
          aria-label={t.nav.closeMenu}
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-arse-yellow hover:text-arse-yellow"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
      </div>

      <div class="mx-auto w-full max-w-7xl flex-1 overflow-y-auto px-5 pb-10 sm:px-8">
        <div class="grid h-full gap-8 lg:grid-cols-[40px_1fr_1px_1fr_1px_1fr] lg:items-stretch">
          <div class="hidden items-end justify-center pb-4 lg:flex">
            <span
              data-active-label
              class="whitespace-nowrap text-xs font-semibold uppercase tracking-[0.3em] text-white/40"
              style="writing-mode: vertical-rl; transform: rotate(180deg);"
            >
              {nav[0].label}
            </span>
          </div>

          <nav class="flex flex-col justify-center gap-3 py-8 lg:py-0" aria-label={t.nav.mainNavigation}>
            {nav.map((item, i) => (
              <a
                href={localizePath(item.href, lang)}
                data-nav-key={item.key}
                class:list={[
                  "js-menu-link font-display text-3xl font-bold leading-tight transition-colors lg:text-5xl",
                  i === 0
                    ? "text-white underline decoration-arse-yellow decoration-2 underline-offset-8"
                    : "text-white/35 hover:text-white/70",
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="hidden bg-white/10 lg:block"></div>

          <div class="hidden flex-col justify-center gap-4 lg:flex">
            {nav.map((item, i) => (
              <div data-nav-panel={item.key} class:list={["max-w-sm", i !== 0 && "hidden"]}>
                <a
                  href={localizePath(item.href, lang)}
                  class="inline-flex items-center gap-2 rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-arse-yellow hover:text-arse-yellow"
                >
                  {item.label}
                  <span class="i-arrow" aria-hidden="true">→</span>
                </a>
                <p class="mt-5 text-sm leading-relaxed text-white/60">{item.desc}</p>
                {item.children.length > 0 && (
                  <ul class="mt-6 space-y-3">
                    {item.children.map((child) => (
                      <li>
                        <a href={localizePath(child.href, lang)} class="text-sm font-semibold text-white/85 transition-colors hover:text-arse-yellow">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>

          <div class="hidden bg-white/10 lg:block"></div>

          <div class="relative hidden overflow-hidden rounded-3xl lg:block">
            {nav.map((item, i) => (
              <img
                src={NAV_IMAGES[item.key]}
                alt=""
                data-nav-image={item.key}
                class:list={[
                  "absolute inset-0 h-full w-full object-cover transition-opacity duration-500",
                  i === 0 ? "opacity-60" : "opacity-0",
                ]}
              />
            ))}
            <div class="absolute inset-0 bg-gradient-to-t from-arse-ink via-transparent to-transparent"></div>
          </div>
        </div>
      </div>

      <div class="border-t border-white/10">
        <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-5 py-5 text-sm text-white/60 sm:px-8">
          <a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="hover:text-arse-yellow">{SITE.phoneDisplay}</a>
          <a href={`mailto:${SITE.email}`} class="hover:text-arse-yellow">{SITE.email}</a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-arse-yellow">Facebook</a>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-arse-yellow">LinkedIn</a>
          <a href={localizePath("/contact/", lang)} class="ml-auto font-semibold text-arse-yellow hover:text-white">
            {t.nav.contact} <span class="i-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMenu } from "../scripts/menu";
  initMenu();

  // Ferme la liste déroulante de langue au clic en dehors (comportement
  // natif de <details> : elle ne se referme que via sa <summary>).
  document.addEventListener("click", (e) => {
    document.querySelectorAll("details[open]").forEach((el) => {
      if (!(e.target instanceof Node) || !el.contains(e.target)) el.removeAttribute("open");
    });
  });
</script>
