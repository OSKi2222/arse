---
import { SITE } from "../lib/site";
import { getLangFromUrl, useTranslations, localizePath, type Lang } from "../i18n";
import { withBase } from "../lib/base";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
  { label: "Facebook", href: SITE.social.facebook },
  { label: "LinkedIn", href: SITE.social.linkedin },
  { label: "YouTube", href: SITE.social.youtube },
  { label: "Telegram", href: SITE.social.telegram },
  { label: "WhatsApp", href: SITE.social.whatsapp },
];
---

<footer class="border-t border-black/5 bg-arse-ink text-white/80">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <img src={withBase("/images/logo-arse-carre.png")} alt={t.site.fullName} class="h-14 w-14 rounded-lg bg-white/5 p-1" width="56" height="56" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/60">
          {SITE.address.street}, {SITE.address.postal} {SITE.address.city}, {SITE.address.country}
        </p>
        <p class="mt-3 text-sm text-white/60">
          <a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="hover:text-white">{SITE.phoneDisplay}</a><br />
          <a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a>
        </p>
        <p class="mt-3 text-sm text-white/45">{t.site.hoursLabel}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-white/15 px-3 py-1.5 text-xs font-medium text-white/70 transition-colors hover:border-arse-green hover:text-white"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>

      {t.footer.columns.map((col) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-white/40">{col.title}</h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={"external" in l && l.external ? l.href : localizePath(l.href, lang)}
                  target={"external" in l && l.external ? "_blank" : undefined}
                  rel={"external" in l && l.external ? "noopener noreferrer" : undefined}
                  class="text-sm text-white/65 hover:text-white"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} {t.site.fullName} ({SITE.name}). {t.footer.rights}</p>
    </div>
  </div>
</footer>
