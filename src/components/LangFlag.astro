---
/**
 * Drapeaux en SVG inline plutôt qu'en emoji : un emoji drapeau dépend
 * d'une police couleur (Noto Color Emoji ou équivalent) qui n'est pas
 * garantie sur tous les systèmes — sans elle, le glyphe retombe sur le
 * code pays en texte brut ("SA" au lieu du drapeau). Le SVG s'affiche à
 * l'identique partout.
 */
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
---

<span class:list={["inline-block overflow-hidden rounded-[2px] align-middle", className]} style="width: 1.15em; height: 0.8em;" aria-hidden="true">
  {lang === "fr" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="1" height="2" x="0" fill="#002395" /><rect width="1" height="2" x="1" fill="#fff" /><rect width="1" height="2" x="2" fill="#ED2939" />
    </svg>
  )}
  {lang === "en" && (
    <svg viewBox="0 0 60 40" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="60" height="40" fill="#00247d" />
      <path d="M0,0 60,40M60,0 0,40" stroke="#fff" stroke-width="8" />
      <path d="M0,0 60,40M60,0 0,40" stroke="#cf142b" stroke-width="3" />
      <path d="M30,0V40M0,20H60" stroke="#fff" stroke-width="12" />
      <path d="M30,0V40M0,20H60" stroke="#cf142b" stroke-width="6" />
    </svg>
  )}
  {lang === "es" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="3" height="2" fill="#AA151B" /><rect width="3" height="1" y="0.5" fill="#F1BF00" />
    </svg>
  )}
  {lang === "de" && (
    <svg viewBox="0 0 3 5" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="3" height="5" fill="#FFCE00" /><rect width="3" height="3.33" fill="#DD0000" /><rect width="3" height="1.67" fill="#000" />
    </svg>
  )}
  {lang === "it" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="1" height="2" x="0" fill="#009246" /><rect width="1" height="2" x="1" fill="#fff" /><rect width="1" height="2" x="2" fill="#CE2B37" />
    </svg>
  )}
  {lang === "ru" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="3" height="2" fill="#fff" /><rect width="3" height="1.333" y="0.667" fill="#0039A6" /><rect width="3" height="0.667" y="1.333" fill="#D52B1E" />
    </svg>
  )}
  {lang === "zh" && (
    <svg viewBox="0 0 30 20" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="30" height="20" fill="#DE2910" />
      <g fill="#FFDE00">
        <path d="M5 3l1.1 3.4H9.6L6.8 8.5l1 3.4L5 9.8 2.2 11.9l1-3.4L.4 6.4h3.5Z" />
        <circle cx="10.5" cy="2" r="0.8" /><circle cx="12" cy="4.5" r="0.8" /><circle cx="12" cy="7.5" r="0.8" /><circle cx="10.5" cy="9.5" r="0.8" />
      </g>
    </svg>
  )}
  {lang === "ja" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="3" height="2" fill="#fff" /><circle cx="1.5" cy="1" r="0.55" fill="#BC002D" />
    </svg>
  )}
  {lang === "ar" && (
    <svg viewBox="0 0 3 2" width="100%" height="100%" preserveAspectRatio="none">
      <rect width="3" height="2" fill="#006C35" />
      <rect x="0.35" y="0.85" width="2.3" height="0.1" fill="#fff" />
      <rect x="0.35" y="1.05" width="1.3" height="0.08" fill="#fff" />
    </svg>
  )}
</span>
