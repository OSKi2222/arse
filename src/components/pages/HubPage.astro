---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, localizePath, type Lang } from "../../i18n";
import { DOC_HERO_IMAGES } from "../../lib/site";

interface Props {
  pageKey: "documentation" | "actualiteHub";
}

const { pageKey } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const page = t.pages[pageKey];
---

<Layout title={page.title} description={page.lede}>
  <PageHero
    lang={lang}
    kicker={page.kicker}
    title={page.title}
    lede={page.lede}
    image={DOC_HERO_IMAGES[pageKey]}
    imageAlt={page.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: page.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div data-reveal class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {page.categories.map((c) => (
        <a
          href={localizePath(c.href, lang)}
          data-reveal-item
          class="group flex flex-col justify-between rounded-3xl border border-black/5 bg-white p-7 shadow-sm transition-shadow hover:shadow-lg hover:shadow-black/5"
        >
          <div>
            <h2 class="text-xl font-bold text-arse-ink group-hover:text-arse-red">{c.label}</h2>
            <p class="mt-3 text-sm leading-relaxed text-arse-ink/60">{c.desc}</p>
          </div>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-arse-green-dark">
            {t.common.consult}
            <span class="i-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
