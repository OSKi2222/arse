---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.organisation;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.organisation}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: t.nav.items[1].label, href: "/arse/presentation/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
      {p.organs.map((o, i) => (
        <div data-reveal class="rounded-3xl border border-black/5 bg-white p-8 shadow-sm">
          <p data-reveal-item class={`text-xs font-semibold uppercase tracking-[0.25em] ${i % 2 === 0 ? "text-arse-green-dark" : "text-arse-red"}`}>
            {String(i + 1).padStart(2, "0")}
          </p>
          <h2 data-reveal-item class="mt-3 text-lg font-bold text-arse-ink">{o.title}</h2>
          <p data-reveal-item class="mt-3 leading-relaxed text-arse-ink/70">{o.text}</p>
        </div>
      ))}
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
