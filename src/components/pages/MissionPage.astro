---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.mission;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.mission}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: t.nav.items[1].label, href: "/arse/presentation/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-20 sm:px-8 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2">
      {p.items.map((item, i) => (
        <article data-stack-item class="flex gap-5 rounded-3xl border border-black/5 bg-white p-7 shadow-sm">
          <span class="text-3xl font-bold text-arse-red/25">{String(i + 1).padStart(2, "0")}</span>
          <p class="leading-relaxed text-arse-ink/75">{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-arse-ink px-5 py-20 text-white sm:px-8 md:py-28">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p data-reveal-item class="text-xs font-semibold uppercase tracking-[0.25em] text-arse-yellow">{p.accountabilityTitle}</p>
      <p data-reveal-item class="mt-4 text-lg leading-relaxed text-white/75">{p.accountability}</p>
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
