---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.historique;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.historique}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: t.nav.items[1].label, href: "/arse/presentation/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto max-w-4xl space-y-12">
      {p.milestones.map((m) => (
        <div data-reveal class="grid gap-4 border-t border-black/10 pt-8 sm:grid-cols-[6rem_1fr] sm:gap-8">
          <p data-reveal-item class="text-3xl font-bold text-arse-red">{m.year}</p>
          <div data-reveal-item>
            <h2 class="text-lg font-bold text-arse-ink">{m.title}</h2>
            <p class="mt-3 leading-relaxed text-arse-ink/70">{m.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
