---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

interface Props {
  pageKey: "cookies" | "terms";
}

const { pageKey } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages[pageKey];
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES[pageKey]}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: p.title }]}
  />

  <section class="bg-white px-5 py-20 sm:px-8 md:py-28">
    <div class="mx-auto max-w-3xl space-y-10">
      {p.sections.map((s) => (
        <div data-reveal class="border-t border-black/10 pt-8 first:border-t-0 first:pt-0">
          <h2 data-reveal-item class="text-lg font-bold text-arse-ink">{s.title}</h2>
          <p data-reveal-item class="mt-3 leading-relaxed text-arse-ink/70">{s.text}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
