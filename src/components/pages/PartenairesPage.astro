---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.partenaires;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.partenaires}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto grid max-w-5xl gap-5 sm:grid-cols-2">
      {p.items.map((partner) => (
        <a
          href={partner.href}
          target="_blank"
          rel="noopener noreferrer"
          data-stack-item
          class="group flex items-center justify-between gap-4 rounded-3xl border border-black/5 bg-white p-7 shadow-sm transition-shadow hover:shadow-lg hover:shadow-black/5"
        >
          <div>
            <h2 class="text-lg font-bold text-arse-ink group-hover:text-arse-red">{partner.name}</h2>
            <p class="mt-2 text-sm leading-relaxed text-arse-ink/60">{partner.desc}</p>
          </div>
          <span class="i-arrow shrink-0 text-arse-green-dark" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
