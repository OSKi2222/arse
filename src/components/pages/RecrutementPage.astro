---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { SITE, PAGE_HERO_IMAGES } from "../../lib/site";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.recrutement;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.recrutement}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: t.nav.items[1].label, href: "/arse/presentation/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2">
      <div data-stack-item class="rounded-3xl bg-arse-red p-8 text-white">
        <h2 class="text-xl font-bold">{p.jobsTitle}</h2>
        <p class="mt-3 leading-relaxed text-white/80">{p.jobsText}</p>
      </div>
      <div data-stack-item class="rounded-3xl bg-arse-green p-8 text-white">
        <h2 class="text-xl font-bold">{p.internshipsTitle}</h2>
        <p class="mt-3 leading-relaxed text-white/80">{p.internshipsText}</p>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-14 sm:px-8 md:py-20">
    <div data-reveal class="mx-auto max-w-2xl">
      <p data-reveal-item class="text-xs font-semibold uppercase tracking-[0.25em] text-arse-red">{p.proceduresTitle}</p>
      <ul class="mt-6 space-y-3">
        {p.procedures.map((item) => (
          <li data-reveal-item class="flex items-center gap-3 rounded-2xl border border-black/5 bg-arse-paper px-5 py-4 text-arse-ink/80">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" class="shrink-0 text-arse-green" aria-hidden="true">
              <path d="M3 10.5 8 15l9-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <div data-reveal-item class="mt-10 rounded-2xl border border-black/5 bg-arse-paper p-6">
        <p class="text-sm font-semibold text-arse-ink">{p.contactTitle}</p>
        <a href={`mailto:${SITE.email}`} class="mt-2 inline-block text-arse-green-dark hover:underline">{SITE.email}</a>
      </div>
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
