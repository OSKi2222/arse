---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import { SITE, PAGE_HERO_IMAGES } from "../../lib/site";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.contact;

const socials = [
  { label: "Facebook", href: SITE.social.facebook },
  { label: "LinkedIn", href: SITE.social.linkedin },
  { label: "YouTube", href: SITE.social.youtube },
  { label: "Telegram", href: SITE.social.telegram },
  { label: "WhatsApp", href: SITE.social.whatsapp },
];
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.contact}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div data-reveal>
        <p data-reveal-item class="text-xs font-semibold uppercase tracking-[0.25em] text-arse-red">{p.infoTitle}</p>
        <p data-reveal-item class="mt-4 leading-relaxed text-arse-ink/70">
          {SITE.address.street}, {SITE.address.postal} {SITE.address.city}, {SITE.address.country}
        </p>
        <p data-reveal-item class="mt-4 space-y-1 text-arse-ink/80">
          <a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="block hover:text-arse-red">{SITE.phoneDisplay}</a>
          <a href={`mailto:${SITE.email}`} class="block hover:text-arse-red">{SITE.email}</a>
        </p>

        <p data-reveal-item class="mt-8 text-xs font-semibold uppercase tracking-[0.25em] text-arse-green-dark">{p.hoursTitle}</p>
        <p data-reveal-item class="mt-3 text-arse-ink/70">{t.site.hoursLabel}</p>

        <div data-reveal-item class="mt-8 flex flex-wrap gap-2">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="rounded-full border border-black/10 px-4 py-2 text-xs font-semibold text-arse-ink/70 transition-colors hover:border-arse-green hover:text-arse-ink">
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <div data-reveal>
        <!--
          Le formulaire est entièrement fonctionnel côté client (validation,
          état "envoi en cours", confirmation) mais n'envoie aucune donnée
          nulle part pour l'instant — voir src/scripts/contactForm.ts pour
          activer le vrai envoi une fois un service (Formspree, EmailJS...)
          configuré. `action`/`method` sont volontairement absents pour
          empêcher toute soumission native si le script venait à échouer.
        -->
        <form
          data-reveal-item
          data-contact-form
          data-sending-text={p.sending}
          data-success-text={p.success}
          class="rounded-3xl border border-black/5 bg-white p-8 shadow-sm"
        >
          <h2 class="text-lg font-bold text-arse-ink">{p.formTitle}</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <input type="text" name="name" placeholder={p.fields.name} required class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red" />
            <input type="tel" name="phone" placeholder={p.fields.phone} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red" />
            <input type="email" name="email" placeholder={p.fields.email} required class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red sm:col-span-2" />
            <input type="text" name="locality" placeholder={p.fields.locality} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red" />
            <input type="text" name="province" placeholder={p.fields.province} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red" />
            <input type="text" name="subject" placeholder={p.fields.subject} required class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red sm:col-span-2" />
            <textarea name="message" placeholder={p.fields.message} required rows="5" class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition-colors focus:border-arse-red sm:col-span-2"></textarea>
          </div>
          <button type="submit" data-magnetic data-submit-btn class="mt-6 inline-flex items-center gap-2 rounded-full bg-arse-red px-7 py-3.5 text-sm font-semibold text-white disabled:opacity-60">
            <span data-submit-label>{p.submit}</span>
            <span class="i-arrow" aria-hidden="true">→</span>
          </button>
          <p data-form-status class="mt-4 hidden text-sm font-semibold text-arse-green-dark" role="status"></p>
          <p class="mt-4 text-xs text-arse-ink/40">{p.formNote}</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { initContactForm } from "../../scripts/contactForm";
    initContactForm();
  </script>
</Layout>
