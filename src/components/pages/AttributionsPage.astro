---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CtaSection from "../CtaSection.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n";
import { PAGE_HERO_IMAGES } from "../../lib/site";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.attributions;
---

<Layout title={p.title} description={p.lede}>
  <PageHero
    lang={lang}
    kicker={p.kicker}
    title={p.title}
    lede={p.lede}
    image={PAGE_HERO_IMAGES.attributions}
    imageAlt={p.title}
    crumbs={[{ label: t.nav.items[0].label, href: "/" }, { label: t.nav.items[1].label, href: "/arse/presentation/" }, { label: p.title }]}
  />

  <section class="bg-arse-paper px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-2">
      <div data-reveal class="rounded-3xl border border-black/5 bg-white p-8 shadow-sm">
        <p data-reveal-item class="text-xs font-semibold uppercase tracking-[0.25em] text-arse-green-dark">{p.consultativeTitle}</p>
        <p data-reveal-item class="mt-3 text-sm text-arse-ink/60">{p.consultativeIntro}</p>
        <ul class="mt-6 space-y-4">
          {p.consultative.map((item) => (
            <li data-reveal-item class="flex gap-3 leading-relaxed text-arse-ink/75">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-arse-green" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal class="rounded-3xl border border-black/5 bg-white p-8 shadow-sm">
        <p data-reveal-item class="text-xs font-semibold uppercase tracking-[0.25em] text-arse-red">{p.decisionTitle}</p>
        <p data-reveal-item class="mt-3 text-sm text-arse-ink/60">{p.decisionIntro}</p>
        <ul class="mt-6 space-y-4">
          {p.decision.map((item) => (
            <li data-reveal-item class="flex gap-3 leading-relaxed text-arse-ink/75">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-arse-red" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaSection lang={lang} compact />
</Layout>
