---
interface Doc {
  title: string;
  meta?: string;
  href: string;
  image?: string;
}

interface Props {
  docs: Doc[];
  downloadLabel: string;
  emptyLabel?: string;
}

const { docs, downloadLabel, emptyLabel = "Aucun document disponible pour le moment." } = Astro.props;
---

{docs.length === 0 ? (
  <p class="text-arse-ink/55">{emptyLabel}</p>
) : (
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
    {docs.map((d) => (
      <a href={d.href} target="_blank" rel="noopener noreferrer" data-stack-item class="group block">
        <div class="overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm">
          {d.image ? (
            <img
              src={d.image}
              alt={d.title}
              loading="lazy"
              class="aspect-[3/4] w-full object-cover transition-transform duration-[800ms] ease-out group-hover:scale-[1.05]"
            />
          ) : (
            <div class="flex aspect-[3/4] w-full flex-col items-center justify-center gap-3 bg-arse-paper p-4 text-center">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="text-arse-red/70" aria-hidden="true">
                <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="M14 2v6h6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
              <span class="text-xs font-semibold leading-snug text-arse-ink/70">PDF</span>
            </div>
          )}
        </div>
        {d.meta && <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-arse-red">{d.meta}</p>}
        <h3 class="mt-1 text-sm font-semibold leading-snug text-arse-ink group-hover:text-arse-red">{d.title}</h3>
        <p class="mt-1 text-xs font-medium text-arse-green-dark">{downloadLabel} <span class="i-arrow" aria-hidden="true">→</span></p>
      </a>
    ))}
  </div>
)}
